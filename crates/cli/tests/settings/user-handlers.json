{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\tools\\guard.exe",
            "args": [
              "--strict"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -File C:\\tools\\notify.ps1",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "theme": "dark"
}
