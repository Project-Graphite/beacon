  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-snapshot",
    "allow-get-detail",
    "allow-acknowledge",
    "allow-dismiss",
    "allow-decide",
    "allow-snooze",
    "allow-unsnooze",
    "allow-refresh-usage",
    "allow-close-panel",
    "allow-set-panel-height",
    "allow-jump",
    "allow-queue-prompt",
    "allow-cancel-prompt",
    "allow-send-prompt-to-window",
    "allow-set-config",
    "allow-hooks-status",
    "allow-hooks-plan",
    "allow-hooks-apply",
    "allow-get-ui-settings",
    "allow-set-ui-settings",
    "allow-get-login-start",
    "allow-set-login-start",
    "allow-preview-attention",
    "allow-open-logs-folder",
