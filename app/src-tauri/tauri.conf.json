{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beacon",
  "identifier": "com.project-graphite.beacon",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "homepage": "https://github.com/Project-Graphite/beacon",
    "copyright": "Copyright (c) 2026 Project Graphite contributors",
    "shortDescription": "Every Claude Code session on your PC in one small panel.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
